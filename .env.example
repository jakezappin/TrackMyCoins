# Copy this file to .env and fill in the values. .env is never committed.

# Random string used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# PCGS Public API token (free: https://www.pcgs.com/publicapi)
PCGS_API_TOKEN=

# Greysheet / CDN Publishing API credentials (greysheet.com > account > API credentials)
GREYSHEET_API_KEY=
GREYSHEET_API_TOKEN=

# Set to true to use Greysheet's sandbox (beta) API instead of production.
GREYSHEET_USE_SANDBOX=false

# Optional: Greysheet catalog node id(s) for a coin series, if automatic discovery picks the wrong one.
# GREYSHEET_NODE_OVERRIDES={"morgan-dollars": [1234]}
